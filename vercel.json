{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__path=/"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=/$1"
    },
    {
      "source": "/((?!api/|assets/|uploads/|screenshots/|\\.well-known/|manifest\\.json|manifest\\.webmanifest|sw\\.js|privacy\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
